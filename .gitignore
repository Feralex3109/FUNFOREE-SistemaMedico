# ==============================
# FUNFOREE-SADHIA
# Git Ignore
# ==============================

# Python
__pycache__/
*.py[cod]
*$py.class
*.pyo

# Entornos virtuales
venv/
.venv/
env/
ENV/

# Django
*.log
db.sqlite3
db.sqlite3-journal
media/
staticfiles/

# Variables de entorno y secretos
.env
.env.*
!.env.example

# Django migrations - conservar archivos de migración
# No ignorar migrations/

# Cobertura y pruebas
.coverage
htmlcov/
.pytest_cache/

# IDE / editores
.vscode/
.idea/
*.swp
*.swo

# Sistema operativo
.DS_Store
Thumbs.db
desktop.ini

# Node / Frontend
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Builds frontend
dist/
build/
.next/
out/

# Archivos temporales
*.tmp
*.temp
*.bak
*.backup

# Archivos de respaldo locales
*.sqlite3
*.sqlite3-journal

# Certificados y claves privadas
*.pem
*.key
*.p12
*.pfx